{{define "sitemap_manga.xml"}}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {{range .mangas}}
    <url>
        <loc>https://mangafoxy.com/{{.Slug}}/</loc>
        <lastmod>{{formatDate .UpdatedAt "c"}}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.8</priority>
    </url>
    {{end}}
</urlset>{{end}}
